# Required
OPENAI_API_KEY=sk-...

# Optional overrides
VESSEL_COPILOT_DB=vessel_copilot.db
VESSEL_COPILOT_MODEL=gpt-4.1

# --- MCP Server Configuration ---
# Set to "true" to route tool calls through FastMCP remote servers.
# When "false" (default), local mock functions are used instead.
MCP_SERVERS_ENABLED=false

# MCP Server URLs (used when MCP_SERVERS_ENABLED=true)
MCP_TELEMETRY_URL=http://localhost:8001/mcp

# --- MLOps Config ---
MODEL_CONFIG_PATH=mlops/model_config.yaml
